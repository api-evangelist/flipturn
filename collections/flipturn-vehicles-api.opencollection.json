{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flipturn Access IDs Vehicles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Vehicles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List vehicles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getflipturn.com/api/vehicles",
            "params": [
              {
                "name": "nextPageCursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor from the previous response's pagination.nextPageCursor to fetch the next page. Keep all other parameters identical."
              }
            ]
          },
          "docs": "Retrieve a paginated list of all electric vehicles and their associated access IDs."
        },
        {
          "info": {
            "name": "Create a vehicle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getflipturn.com/api/vehicles",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new vehicle, optionally associating one or more access IDs and a customer."
        },
        {
          "info": {
            "name": "Get a vehicle",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getflipturn.com/api/vehicles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the details for a specific vehicle."
        },
        {
          "info": {
            "name": "Update a vehicle",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.getflipturn.com/api/vehicles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a vehicle. Explicitly providing null deletes an optional value; omitting a field leaves it unchanged."
        }
      ]
    }
  ],
  "bundled": true
}