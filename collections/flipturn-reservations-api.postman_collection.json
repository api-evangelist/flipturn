          "name": "Reserve a charging port",
          "request": {
            "name": "Reserve a charging port",
            "description": {
              "content": "Reserve a charging port for a specific user via the OCPP ReserveNow message. The reservation is active immediately and expires at expiryDate. Supports OCPP 1.6 and 2.0.1 chargers with the Reservation profile.",
