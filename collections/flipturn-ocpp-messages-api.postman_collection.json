          "name": "List OCPP messages for a charger",
          "request": {
            "name": "List OCPP messages for a charger",
            "description": {
              "content": "Retrieve raw OCPP (Open Charge Point Protocol) messages for a specific charger, newest first. The date range must be under 8 days. Page size is controlled by limit (default 50, max 500).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ocpp-messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chargerId",
                  "value": "<integer>",
                  "description": "(Required) The ID of the charger to retrieve messages for."
                },
                {
                  "disabled": false,
                  "key": "startTimestamp",
                  "value": "<dateTime>",
                  "description": "ISO 8601: messages after this time. Defaults to 24 hours ago."
                },
                {
                  "disabled": false,
                  "key": "endTimestamp",
                  "value": "<dateTime>",
                  "description": "ISO 8601: messages before this time. Defaults to now."
                },
                {
                  "disabled": false,
                  "key": "messageType",
                  "value": "<string>",
                  "description": "Filter by OCPP message type(s), e.g. Authorize or messageType[]=StartTransaction."
                },
                {
                  "disabled": false,
                  "key": "messageType",
                  "value": "<string>",
                  "description": "Filter by OCPP message type(s), e.g. Authorize or messageType[]=StartTransaction."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (default 50"
                },
                {
                  "disabled": false,
                  "key": "nextPageCursor",
                  "value": "<string>",
                  "description": "Opaque cursor from the previous response's pagination.nextPageCursor to fetch the next page. Keep all other parameters identical."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
